    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.accessToken) {",
                  "        pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "        console.log('Access and Refresh tokens updated in collection variables');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
