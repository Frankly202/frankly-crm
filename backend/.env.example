# Server Configuration
NODE_ENV=development
PORT=4000

# Database Configuration (PostgreSQL 16 via Docker — local dev)
DATABASE_URL=postgresql://frankly_user:frankly_pass@localhost:5435/frankly_crm?schema=public
# Direct (non-pooled) connection used by Prisma CLI and for interactive transactions.
# Local dev: same as DATABASE_URL.
# Production on Render (IPv4-only): Render cannot reach the Supabase Direct connection on the
# Free plan (it is IPv6-only). Use Supavisor SESSION MODE (port 5432) for both variables:
#   DATABASE_URL = postgres://postgres.[ref]:[pass]@aws-[region].pooler.supabase.com:5432/postgres
#   DIRECT_URL   = postgres://postgres.[ref]:[pass]@aws-[region].pooler.supabase.com:5432/postgres
# If you have the Supabase IPv4 add-on, DIRECT_URL may use the direct URL (db.[ref].supabase.co:5432).
# Do NOT use Transaction Mode (port 6543) for either variable — it breaks interactive transactions
# and Prisma DDL migrations.
DIRECT_URL=postgresql://frankly_user:frankly_pass@localhost:5435/frankly_crm?schema=public

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Initial Admin User (Seeded on first setup)
INITIAL_ADMIN_EMAIL=emmanuel@frankedu-global.com
INITIAL_ADMIN_PASSWORD=FranklyAdmin2026!

# JWT & Authentication Security (min 32 chars in production)
JWT_SECRET=frankly_super_secure_jwt_secret_key_minimum_32_chars_2026
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# External Provider Integrations (Phase 9)
# PROVIDER_MODE: 'mock' (default, safe for local testing/CI) or 'live' (fail-closed, requires real provider credentials)
PROVIDER_MODE=mock

# Meta Platform Integration (Shared Configuration)
# Supported Graph API version (v26.0 is current stable LTS). Consumed by all Meta channel adapters.
META_GRAPH_API_VERSION=v26.0
# Meta Developer App ID. Consumed for app identification and App Review verification.
META_APP_ID=
# Meta Developer App Secret. Consumed by meta-signature.util.ts for HMAC SHA-256 webhook validation (x-hub-signature-256).
META_APP_SECRET=
# Custom verification token string. Consumed by WebhookController.verifyMetaChallenge for GET challenge handshakes.
META_VERIFY_TOKEN=frankly_test_verify_token

# WhatsApp Business Cloud API
# WhatsApp Business Account (WABA) ID. Consumed for webhook tenant filtering and message template management.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Phone Number ID from Meta WhatsApp API Setup. Consumed by WhatsAppAdapter.sendOutboundMessage to target the endpoint.
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User Access Token with whatsapp_business_messaging. Consumed by WhatsAppAdapter.sendOutboundMessage.
WHATSAPP_ACCESS_TOKEN=

# Instagram Professional Direct Messaging (Graph API)
# Facebook Page ID connected to the Instagram Professional account. Consumed by InstagramAdapter.
INSTAGRAM_PAGE_ID=
# Instagram Professional Account ID (IG User ID). Consumed by InstagramAdapter for user profile lookups.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Page Access Token with instagram_manage_messages & instagram_basic. Consumed by InstagramAdapter.sendOutboundMessage.
# (Note: If Facebook Page is identical to FACEBOOK_PAGE_ID, this can optionally fall back to FACEBOOK_PAGE_ACCESS_TOKEN).
INSTAGRAM_ACCESS_TOKEN=

# Facebook Page Messenger (Graph API)
# Facebook Page ID. Consumed by MessengerAdapter.sendOutboundMessage.
FACEBOOK_PAGE_ID=
# Page Access Token with pages_messaging. Consumed by MessengerAdapter.sendOutboundMessage.
FACEBOOK_PAGE_ACCESS_TOKEN=

# Resend Email Integration
# Inbound testing does NOT require DNS/MX changes; production branded domain requires dedicated subdomain setup.
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

